# Öffentliche Supabase-Werte. Niemals den service_role-Schlüssel eintragen.
NUXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Web Push. Schlüssel mit: npx web-push generate-vapid-keys
NUXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
NUXT_VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
NUXT_VAPID_SUBJECT=mailto:you@example.com
